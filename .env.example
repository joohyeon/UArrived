# Copy to .env (gitignored). List variable NAMES here, never real values.

# Verification email (interop/email_sender.py). Without SMTP_HOST, verification can't send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public base URL used in emailed links
UARRIVED_PUBLIC_URL=http://localhost:8000
# Demo only: return verification tokens in the response instead of emailing. Never in the pilot.
UARRIVED_DEV_MODE=0
# 1 switches every AI model off (drafting, translation, Help me decide); tests set it
UARRIVED_AI_OFF=0
# Comma-separated @umich.edu addresses of moderators (must also be verified)
UARRIVED_MODERATORS=
# LLM for drafting posts (ai/draft.jac uses claude-haiku-4-5)
ANTHROPIC_API_KEY=
# Match email digest: seconds between sweeps (serve mode only), and a file to write emails to instead of SMTP (demos)
UARRIVED_NOTIFY_INTERVAL=600
UARRIVED_EMAIL_OUTBOX=
# Salt for one-way block keys (market/graph.jac pair_key). Set once per deployment; changing it forgets existing blocks.
UARRIVED_BLOCK_SALT=
