# Copy to .env (gitignored). List variable NAMES here, never real values.

# Verification email (interop/email_sender.py). Without SMTP_HOST, verification can't send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public base URL used in emailed links
UARRIVED_PUBLIC_URL=http://localhost:8000
# Demo only: return verification tokens in the response instead of emailing. Never in the pilot.
UARRIVED_DEV_MODE=0
